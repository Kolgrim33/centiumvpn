<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/centium_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- Centium VPN Primary Power Button -->
        <FrameLayout
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp">

            <!-- Circular Status Background -->
            <View
                android:id="@+id/buttonGlowRing"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/card_background" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConnectToggle"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_gravity="center"
                android:text="@string/action_connect"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:backgroundTint="@color/centium_primary"
                app:cornerRadius="80dp"
                app:elevation="8dp" />

        </FrameLayout>

        <!-- Current Status and Subtitle -->
        <TextView
            android:id="@+id/tvStatusTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/state_disconnected"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/tvStatusSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap Connect to start Tor VPN"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="4dp" />

        <!-- Bootstrap Progress Bar -->
        <ProgressBar
            android:id="@+id/pbBootstrap"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="16dp"
            android:max="100"
            android:progress="0"
            android:visibility="gone"
            android:progressTint="@color/centium_accent" />

        <!-- Security / Kill Switch Status Badge Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/card_background"
            android:padding="14dp"
            android:layout_marginTop="20dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_vpn_lock"
                app:tint="@color/centium_primary"
                android:contentDescription="Security" />

            <TextView
                android:id="@+id/tvKillSwitchBanner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Fail-Closed Kill Switch Armed"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />

        </LinearLayout>

        <!-- Live Traffic Telemetry Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginTop="12dp">

            <!-- Download -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/metric_download"
                    android:textSize="11sp"
                    android:textColor="@color/text_muted" />

                <TextView
                    android:id="@+id/tvDownloadBytes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 KB"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/centium_primary" />

            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/centium_border" />

            <!-- Upload -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/metric_upload"
                    android:textSize="11sp"
                    android:textColor="@color/text_muted" />

                <TextView
                    android:id="@+id/tvUploadBytes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 KB"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/centium_accent" />

            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/centium_border" />

            <!-- Exit IP -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/metric_exit_ip"
                    android:textSize="11sp"
                    android:textColor="@color/text_muted" />

                <TextView
                    android:id="@+id/tvExitIp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

            </LinearLayout>

        </LinearLayout>

        <!-- Tor Circuit Info Card -->
        <LinearLayout
            android:id="@+id/circuitCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACTIVE TOR CIRCUIT"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/text_muted"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvCircuitNodes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Guard ➔ Middle ➔ Exit"
                android:textSize="13sp"
                android:textColor="@color/text_secondary" />

        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNewIdentity"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="@string/action_new_identity"
                android:textColor="@color/text_primary"
                app:strokeColor="@color/centium_border" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRunDiagnostics"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="@string/action_diagnostics"
                android:textColor="@color/centium_accent"
                app:strokeColor="@color/centium_accent" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
