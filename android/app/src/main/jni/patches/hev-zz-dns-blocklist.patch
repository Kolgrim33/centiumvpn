 static HevMappedDNS *singleton;
 
+/*
+ * Domain blocklist (Centium). A sorted array of lowercase domains loaded from a
+ * file, one domain per line. A query is blocked when the queried name equals a
+ * listed domain or is a subdomain of one, so "doubleclick.net" also covers
+ * "ads.g.doubleclick.net". Matching is a bsearch per label, a handful of
+ * comparisons per lookup. The list loads once when the tunnel starts.
+ */
+static char **blocklist;
+static int blocklist_len;
+
+#define HEV_DNS_MAX_NAME 255
+
+static int
+blocklist_cmp (const void *a, const void *b)
+{
+    return strcmp (*(const char *const *)a, *(const char *const *)b);
+}
+
+static int
+blocklist_has (const char *name)
+{
+    return bsearch (&name, blocklist, blocklist_len, sizeof (char *),
+                    blocklist_cmp) != NULL;
+}
+
+/* True if name equals, or is a subdomain of, a listed domain. */
+static int
+blocklist_blocks (const char *name)
+{
+    char lower[HEV_DNS_MAX_NAME + 1];
+    const char *p;
+    int i;
+
+    if (!blocklist_len || !name)
+        return 0;
+
+    for (i = 0; name[i] && i < HEV_DNS_MAX_NAME; i++)
+        lower[i] = tolower ((unsigned char)name[i]);
+    lower[i] = '\0';
+
+    for (p = lower; p; ) {
+        if (blocklist_has (p))
+            return 1;
+        p = strchr (p, '.');
+        if (p)
+            p++;
+    }
+
+    return 0;
+}
+
+void
+hev_mapped_dns_set_blocklist (const char *path)
+{
+    char line[HEV_DNS_MAX_NAME + 2];
+    char **list = NULL;
+    int cap = 0;
+    int len = 0;
+    FILE *fp;
+    int i;
+
+    for (i = 0; i < blocklist_len; i++)
+        free (blocklist[i]);
+    free (blocklist);
+    blocklist = NULL;
+    blocklist_len = 0;
+
+    if (!path || !path[0])
+        return;
+
+    fp = fopen (path, "r");
+    if (!fp) {
+        LOG_W ("blocklist: cannot open %s", path);
+        return;
+    }
+
+    while (fgets (line, sizeof (line), fp)) {
+        char *s = line;
+        int n;
+
+        while (*s == ' ' || *s == '\t')
+            s++;
+        n = strlen (s);
+        while (n > 0 && (s[n - 1] == '\n' || s[n - 1] == '\r' ||
+                         s[n - 1] == ' ' || s[n - 1] == '\t'))
+            s[--n] = '\0';
+        if (n == 0 || s[0] == '#')
+            continue;
+        for (i = 0; i < n; i++)
+            s[i] = tolower ((unsigned char)s[i]);
+
+        if (len == cap) {
+            int ncap = cap ? cap * 2 : 4096;
+            char **nl = realloc (list, ncap * sizeof (char *));
+            if (!nl)
+                break;
+            list = nl;
+            cap = ncap;
+        }
+        list[len] = strdup (s);
+        if (!list[len])
+            break;
+        len++;
+    }
+    fclose (fp);
+
+    if (list)
+        qsort (list, len, sizeof (char *), blocklist_cmp);
+
+    blocklist = list;
+    blocklist_len = len;
+    LOG_I ("blocklist: %d domains loaded", len);
+}
