rules_version = '2';

// The only thing the public site may do: add exactly 1 to the download counter.
// Nothing is readable. The owner seeds stats/downloads and reads it with admin access.
service cloud.firestore {
  match /databases/{database}/documents {
    match /stats/downloads {
      allow update: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count is int
        && request.resource.data.count == resource.data.count + 1;
    }
  }
}
