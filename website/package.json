{
  "name": "centium-website",
  "private": true,
  "type": "module",
  "scripts": {
    "test:rules": "firebase emulators:exec --only firestore --project demo-centium \"node --test test/*.test.mjs\"",
    "serve": "firebase emulators:start --only hosting,firestore --project demo-centium",
    "downloads": "node scripts/downloads.mjs",
    "deploy": "firebase deploy --only hosting,firestore:rules"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.10.0"
  }
}
