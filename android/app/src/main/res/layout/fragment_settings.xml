<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:accessibilityHeading="true"
            android:textAppearance="@style/TextAppearance.Centium.Heading" />

        <!-- Safety -->
        <TextView
            style="@style/Centium.SectionLabel"
            android:text="@string/settings_group_safety" />

        <LinearLayout style="@style/Centium.Group">

            <LinearLayout style="@style/Centium.Row">
                <LinearLayout style="@style/Centium.RowText">
                    <TextView style="@style/Centium.RowTitle" android:text="@string/settings_kill_switch" />
                    <TextView style="@style/Centium.RowSummary" android:text="@string/settings_kill_switch_summary" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchKillSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:contentDescription="@string/settings_kill_switch" />
            </LinearLayout>

            <View style="@style/Centium.Divider" />

            <LinearLayout style="@style/Centium.Row">
                <LinearLayout style="@style/Centium.RowText">
                    <TextView style="@style/Centium.RowTitle" android:text="@string/settings_block_ipv6" />
                    <TextView style="@style/Centium.RowSummary" android:text="@string/settings_block_ipv6_summary" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchBlockIpv6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:contentDescription="@string/settings_block_ipv6" />
            </LinearLayout>

            <View style="@style/Centium.Divider" />

            <LinearLayout style="@style/Centium.Row">
                <LinearLayout style="@style/Centium.RowText">
                    <TextView style="@style/Centium.RowTitle" android:text="@string/settings_always_on" />
                    <TextView style="@style/Centium.RowSummary" android:text="@string/settings_always_on_summary" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenVpnSettings"
                    style="@style/Widget.Centium.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/settings_open" />
            </LinearLayout>
        </LinearLayout>

        <!-- Exit country -->
        <TextView
            style="@style/Centium.SectionLabel"
            android:text="@string/settings_group_exit" />

        <LinearLayout style="@style/Centium.Group">
            <LinearLayout
                style="@style/Centium.Row"
                android:orientation="vertical">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilExitCountry"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxStrokeColor="@color/route"
                    app:boxCornerRadiusTopStart="10dp"
                    app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp"
                    app:boxCornerRadiusBottomEnd="10dp">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/acExitCountry"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:contentDescription="@string/settings_group_exit"
                        android:textAppearance="@style/TextAppearance.Centium.Body"
                        android:textColor="@color/ink" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/Centium.RowSummary"
                    android:layout_marginTop="10dp"
                    android:text="@string/settings_exit_summary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bridges -->
        <TextView
            style="@style/Centium.SectionLabel"
            android:text="@string/settings_group_bridges" />

        <LinearLayout style="@style/Centium.Group">
            <LinearLayout
                style="@style/Centium.Row"
                android:orientation="vertical">

                <TextView
                    style="@style/Centium.RowSummary"
                    android:layout_marginTop="0dp"
                    android:text="@string/settings_bridges_summary" />

                <RadioGroup
                    android:id="@+id/rgBridgeMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rbBridgeAuto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_bridges_auto"
                        android:textAppearance="@style/TextAppearance.Centium.Body"
                        android:textColor="@color/ink" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rbBridgeNone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_bridges_direct"
                        android:textAppearance="@style/TextAppearance.Centium.Body"
                        android:textColor="@color/ink" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rbBridgeSnowflake"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_bridges_snowflake"
                        android:textAppearance="@style/TextAppearance.Centium.Body"
                        android:textColor="@color/ink" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rbBridgeObfs4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_bridges_obfs4"
                        android:textAppearance="@style/TextAppearance.Centium.Body"
                        android:textColor="@color/ink" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rbBridgeCustom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_bridges_custom"
                        android:textAppearance="@style/TextAppearance.Centium.Body"
                        android:textColor="@color/ink" />
                </RadioGroup>

                <LinearLayout
                    android:id="@+id/groupCustomBridges"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/etCustomBridges"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minLines="3"
                        android:gravity="top|start"
                        android:padding="12dp"
                        android:background="@drawable/field_background"
                        android:hint="@string/settings_bridges_hint"
                        android:importantForAutofill="no"
                        android:inputType="textMultiLine|textNoSuggestions"
                        android:typeface="monospace"
                        android:textSize="13sp"
                        android:textColor="@color/ink"
                        android:textColorHint="@color/faint" />

                    <TextView
                        style="@style/Centium.RowSummary"
                        android:layout_marginTop="8dp"
                        android:text="@string/settings_bridges_note" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Updates -->
        <TextView
            android:id="@+id/labelUpdates"
            style="@style/Centium.SectionLabel"
            android:text="@string/settings_group_updates" />

        <LinearLayout
            android:id="@+id/groupUpdates"
            style="@style/Centium.Group">

            <LinearLayout style="@style/Centium.Row">
                <LinearLayout style="@style/Centium.RowText">
                    <TextView style="@style/Centium.RowTitle" android:text="@string/settings_auto_update" />
                    <TextView style="@style/Centium.RowSummary" android:text="@string/settings_auto_update_summary" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchAutoUpdate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:contentDescription="@string/settings_auto_update" />
            </LinearLayout>

            <View style="@style/Centium.Divider" />

            <LinearLayout style="@style/Centium.Row">
                <LinearLayout style="@style/Centium.RowText">
                    <TextView
                        android:id="@+id/tvUpdateVersion"
                        style="@style/Centium.RowTitle" />
                    <TextView
                        android:id="@+id/tvUpdateStatus"
                        style="@style/Centium.RowSummary"
                        android:accessibilityLiveRegion="polite" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCheckUpdate"
                    style="@style/Widget.Centium.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/update_check_now" />
            </LinearLayout>
        </LinearLayout>

        <!-- About -->
        <TextView
            style="@style/Centium.SectionLabel"
            android:text="@string/settings_group_about" />

        <LinearLayout style="@style/Centium.Group">

            <LinearLayout style="@style/Centium.Row">
                <LinearLayout style="@style/Centium.RowText">
                    <TextView style="@style/Centium.RowTitle" android:text="@string/settings_website" />
                    <TextView style="@style/Centium.RowSummary" android:text="@string/settings_website_summary" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenWebsite"
                    style="@style/Widget.Centium.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/settings_website_open" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveSettings"
            style="@style/Widget.Centium.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/settings_save" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_horizontal"
            android:text="@string/settings_save_note"
            android:textAppearance="@style/TextAppearance.Centium.Small" />
    </LinearLayout>
</ScrollView>
