<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="24dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHeadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/headline_off"
                android:accessibilityLiveRegion="polite"
                android:textAppearance="@style/TextAppearance.Centium.Display" />

            <TextView
                android:id="@+id/tvBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxWidth="440dp"
                android:minLines="3"
                android:text="@string/body_off"
                android:textAppearance="@style/TextAppearance.Centium.Body" />

            <org.centium.vpn.ui.RouteLineView
                android:id="@+id/route"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp">

            <LinearLayout
                android:id="@+id/rowPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="44dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="true">

                    <TextView
                        android:id="@+id/tvPhoneTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/station_phone"
                        android:textAppearance="@style/TextAppearance.Centium.Title"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tvPhoneMeta"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:gravity="end"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:fontFeatureSettings="tnum"
                        android:textAppearance="@style/TextAppearance.Centium.Small"
                        android:textColor="@color/ink" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPhoneDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/station_phone_off"
                    android:textAppearance="@style/TextAppearance.Centium.Small" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/rowGuard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="44dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="true">

                    <TextView
                        android:id="@+id/tvGuardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/station_guard"
                        android:textAppearance="@style/TextAppearance.Centium.Title"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tvGuardMeta"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:gravity="end"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:fontFeatureSettings="tnum"
                        android:textAppearance="@style/TextAppearance.Centium.Small"
                        android:textColor="@color/ink" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvGuardDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/station_guard_desc"
                    android:textAppearance="@style/TextAppearance.Centium.Small" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/rowMiddle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="44dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="true">

                    <TextView
                        android:id="@+id/tvMiddleTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/station_middle"
                        android:textAppearance="@style/TextAppearance.Centium.Title"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tvMiddleMeta"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:gravity="end"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:fontFeatureSettings="tnum"
                        android:textAppearance="@style/TextAppearance.Centium.Small"
                        android:textColor="@color/ink" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvMiddleDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/station_middle_desc"
                    android:textAppearance="@style/TextAppearance.Centium.Small" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/rowExit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="44dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="true">

                    <TextView
                        android:id="@+id/tvExitTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/station_exit"
                        android:textAppearance="@style/TextAppearance.Centium.Title"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tvExitMeta"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:gravity="end"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:fontFeatureSettings="tnum"
                        android:textAppearance="@style/TextAppearance.Centium.Small"
                        android:textColor="@color/ink" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvExitDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/station_exit_desc"
                    android:textAppearance="@style/TextAppearance.Centium.Small" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/rowInternet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="44dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="true">

                    <TextView
                        android:id="@+id/tvInternetTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/station_internet"
                        android:textAppearance="@style/TextAppearance.Centium.Title"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tvInternetMeta"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:gravity="end"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:fontFeatureSettings="tnum"
                        android:textAppearance="@style/TextAppearance.Centium.Small"
                        android:textColor="@color/ink" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvInternetDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/station_internet_off"
                    android:textAppearance="@style/TextAppearance.Centium.Small" />
            </LinearLayout>
            </org.centium.vpn.ui.RouteLineView>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvTraffic"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFeatureSettings="tnum"
                android:textAppearance="@style/TextAppearance.Centium.Small"
                android:visibility="invisible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNewCircuit"
                style="@style/Widget.Centium.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_new_circuit"
                android:visibility="invisible" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConnectToggle"
            style="@style/Widget.Centium.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/action_connect"
            app:strokeColor="@color/ink" />
    </LinearLayout>
</LinearLayout>
